# Veritas AI - Backend Environment Variables
# Copy this file to .env and fill in your values.

# ── Database (OPTIONAL) ────────────────────────────────────────────────────────
# Leave empty to run in self-contained local mode (JSON file storage under data/).
# Set to a PostgreSQL / Supabase connection string to persist documents in SQL.
# Format: postgresql://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# ── Supabase Storage (OPTIONAL) ──────────────────────────────────────────────
# Leave empty to store uploaded files on the local filesystem.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
TOKEN_TTL_HOURS=12

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI/Chatbot (Groq API) ───────────────────────────────────────────────────
# Optional. Without a key the assistant uses deterministic local responses.
GROQ_API_KEY=
# GROK_API_KEY= is a deprecated alias for GROQ_API_KEY — prefer GROQ_API_KEY above

# ── Government API Integration ──────────────────────────────────────────────
# Set to LIVE to use real APIs, MOCK for offline deterministic verification.
GOV_ADAPTER_MODE=MOCK
GSTINAPI_KEY=
DATA_GOV_API_KEY=
SUREPASS_TOKEN=
APISATHI_API_KEY=
PROTEAN_OPV_TOKEN=
PROTEAN_OPV_SUBAGENTID=
DIDIT_API_KEY=
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# ── Translation Service ─────────────────────────────────────────────────────
LIBRETRANSLATE_URL=http://localhost:5001
LIBRETRANSLATE_TIMEOUT=20

# ── Files (Local fallback if Supabase Storage not configured) ───────────────
# UPLOAD_DIR=./uploads
# REPORTS_DIR=./reports
# DATA_DIR=./data

# ── Debug ────────────────────────────────────────────────────────────────────
# DEBUG_ERRORS=1

# ── Rate Limiting ────────────────────────────────────────────────────────────
# Set to a Redis or Memcache URI for multi-worker deployments (e.g. Render with
# multiple dynos). In-memory rate limiting is used when this is not set, which
# is NOT shared across workers. Example: redis://localhost:6379
RATELIMIT_STORAGE_URI=
